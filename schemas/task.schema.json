  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "tool_catalog_version": {
      "default": "map_tools_v0.1",
      "title": "Tool Catalog Version",
      "type": "string"
    },
    "language": {
      "default": "vi",
      "title": "Language",
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "task_type": {
      "title": "Task Type",
      "type": "string"
    },
    "user_request": {
      "title": "User Request",
      "type": "string"
