      "type": "object"
    },
    "ToolCall": {
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "title": "Args",
          "type": "object"
        }
      },
      "required": [
        "tool"
      ],
      "title": "ToolCall",
      "type": "object"
    }
