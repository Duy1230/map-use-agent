          "default": null,
          "title": "Speed Kmh"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "heading_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Deg"
        },
        "extra": {
          "title": "Extra",
          "type": "object"
        }
      },
      "title": "ObjectProperties",
      "type": "object"
    },
    "ScenarioObjects": {
      "properties": {
        "vehicles": {
          "items": {
            "$ref": "#/$defs/MapObject"
          },
