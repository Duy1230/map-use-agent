            {
              "$ref": "#/$defs/GeoJSONLineString"
            }
          ],
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/ObjectProperties"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "geometry"
      ],
      "title": "MapObject",
      "type": "object"
    },
    "ObjectProperties": {
      "properties": {
        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
