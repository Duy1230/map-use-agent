        },
        "cameras": {
          "items": {
            "$ref": "#/$defs/MapObject"
          },
          "title": "Cameras",
          "type": "array"
        },
        "polygons": {
          "items": {
            "$ref": "#/$defs/MapObject"
          },
          "title": "Polygons",
          "type": "array"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/MapObject"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "title": "ScenarioObjects",
      "type": "object"
    },
    "TrajectoryPoint": {
      "properties": {
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "coordinates"
      ],
      "title": "TrajectoryPoint",
      "type": "object"
    }
  },
  "properties": {
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "coordinate_system": {
      "default": "EPSG:4326",
      "title": "Coordinate System",
      "type": "string"
    },
    "time": {
      "title": "Time",
      "type": "string"
    },
    "objects": {
      "$ref": "#/$defs/ScenarioObjects"
    },
    "objects_by_type": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/MapObject"
        },
        "type": "array"
      },
      "title": "Objects By Type",
      "type": "object"
    },
    "time_series": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "$ref": "#/$defs/TrajectoryPoint"
